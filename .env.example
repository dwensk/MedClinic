# === Основной стек: PostgreSQL ===
DATABASE_URL=postgresql+psycopg2://medklinik:medklinik@localhost:5432/medklinik

# === Для быстрой локальной разработки можно использовать SQLite: ===
# DATABASE_URL=sqlite:///./medklinik.db

APP_NAME=МедКлиник API
DEBUG=True

# Длинная случайная строка. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Пароли для начального сидинга базы данных (python -m app.seed).
# Измените перед первым запуском в продакшене.
ADMIN_PASSWORD=admin12345
DOCTOR_PASSWORD=doctor12345
